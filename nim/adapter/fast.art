;; fast.art — the compiled core, called from Arturo.
;;
;;     import ./"nim/adapter/fast.art"!
;;     scanFast input rule
;;
;; Arturo cannot gain a builtin without changing Arturo, but it can call a
;; shared library, so that is the seam. scanFast answers the same question
;; as scan and returns the same shape, while the matching happens in the
;; compiled core.
;;
;; Build the library first:
;;
;;     cd nim
;;     nim c --app:lib -d:release -o:libcarpintero.dylib src/carpintero_ffi.nim
;;
;; The grammar and the input cross as JSON, because call.external carries
;; scalars and nothing else. What comes back is spans rather than values:
;; where each capture started and ended, and which into descent it was
;; inside. This side then slices its own input, so a captured value keeps
;; its exact identity instead of being rebuilt from a serialization, and the
;; types the library models opaquely survive the round trip untouched.

import ./"export.art"!

;; ── JSON, as a string ────────────────────────────────────────────────
;; write.json needs a file, and the point of calling a library rather than
;; writing one is to avoid the filesystem, so the rendering is here.

JQ: to :char 34
JB: to :char 92

SJQ: to :string JQ
SJB: to :string JB
SNL: to :string to :char 10
STB: to :string to :char 9
SCR: to :string to :char 13

;; Escaping runs as native replace passes rather than a character loop.
;; Arturo indexes a string by walking it, and a loop that touches every
;; character costs about 2.5 microseconds each, which over a corpus is
;; most of the time the whole bridge spends. `replace` scans in native
;; code and is flat in the length of the string: at 1600 characters the
;; loop took 1011 ms per 200 calls and this takes 1.7.
;;
;; The five passes cover what JSON requires plus the three control
;; characters that occur in practice. A string carrying any other control
;; character takes the slow path, which is exact.
CTRL: {/[\x00-\x08\x0b\x0c\x0e-\x1f]/}
;; anything JSON cannot carry raw
DIRTY: {/["\\\x00-\x1f]/}

jsonEscapeSlow: function [s][
    out: []
    i: 0
    n: size s
    while [i < n][
        c: s\[i]
        cp: to :integer c
        done: false
        if c = JQ [ out: append out @[SJB ++ SJQ]  done: true ]
        if and? [not? done] [c = JB]  [ out: append out @[SJB ++ SJB]  done: true ]
        if and? [not? done] [cp = 10] [ out: append out @[SJB ++ "n"]  done: true ]
        if and? [not? done] [cp = 9]  [ out: append out @[SJB ++ "t"]  done: true ]
        if and? [not? done] [cp = 13] [ out: append out @[SJB ++ "r"]  done: true ]
        if and? [not? done] [cp < 32] [
            out: append out @[SJB ++ "u00" ++ pad.left.with:`0` (to :string .format:"x" cp) 2]
            done: true
        ]
        unless done [ out: append out @[to :string c] ]
        i: i + 1
    ]
    join out
]

jsonEscapePasses: function [s][
    ; backslash first, or it doubles what the later passes introduce
    r: replace s SJB SJB ++ SJB
    r: replace r SJQ SJB ++ SJQ
    r: replace r SNL SJB ++ "n"
    r: replace r STB SJB ++ "t"
    replace r SCR SJB ++ "r"
]

;; A function whose body assigns anything pays for a scope, about 7
;; microseconds, and it pays whether or not the assignment is reached: an
;; assignment behind an early return costs the same as one on every path.
;; This is called once per string in the corpus and nearly always returns at
;; the first test, so the two branches that need locals live elsewhere and
;; this body assigns nothing.
jsonEscape: function [s][
    ; most strings need nothing done to them, and one native test is much
    ; cheaper than five native passes
    unless match? s DIRTY -> return s
    if match? s CTRL -> return jsonEscapeSlow s
    jsonEscapePasses s
]

jsonString: function [v][
    t: to :string type v
    if t = "dictionary" [
        ks: keys v
        parts: []
        i: 0
        n: size ks
        while [i < n][
            k: ks\[i]
            parts: append parts @[JQ ++ (jsonEscape k) ++ JQ ++ ":" ++ jsonString v\[k]]
            i: i + 1
        ]
        return "{" ++ (join.with: "," parts) ++ "}"
    ]
    if t = "block" [
        return "[" ++ (join.with: "," map v 'e -> jsonString e) ++ "]"
    ]
    if t = "string"   -> return JQ ++ (jsonEscape v) ++ JQ
    if t = "integer"  -> return to :string v
    if t = "floating" -> return to :string v
    if t = "logical"  -> return (v)? -> "true" -> "false"
    if t = "null"     -> return "null"
    JQ ++ (jsonEscape to :string v) ++ JQ
]

;; ── values, straight to text ─────────────────────────────────────────
;; The input is the bulk of what crosses, so it does not go through the
;; tagged dictionaries `itemTree` builds. Walking the Arturo value once and
;; emitting text directly skips building a tree only to walk it again, and a
;; two-element array costs fewer characters and fewer joins than an object
;; with named fields. Over Arturo's own source the pair is worth about
;; twenty-eight times: 5.3 seconds for `itemTree` plus `jsonString`, 0.19
;; for this.
;;
;; Types are compared as type values rather than stringified per node, since
;; `to :string type v` is a conversion for every element in the corpus.

TBLOCK: to :type "block"
TSTR:   to :type "string"
TWORD:  to :type "word"
TLABEL: to :type "label"
TLIT:   to :type "literal"
TSYM:   to :type "symbol"
TSYML:  to :type "symbolliteral"
TTYPE:  to :type "type"
TINT:   to :type "integer"
TFLOAT: to :type "floating"
TLOG:   to :type "logical"
TCHAR:  to :type "char"
TNULL:  to :type "null"
TDICT:  to :type "dictionary"

qs: function [x][ SJQ ++ (jsonEscape x) ++ SJQ ]

;; A word, label, symbol or literal comes from the lexer and in practice
;; never carries a quote or a backslash: over Arturo's own source that is
;; 80,403 of them and none needing an escape. "In practice" is not "never",
;; so they are still guarded, but by two native `contains?` rather than the
;; regex the general path uses. The guard costs about 8% and removes the
;; only way this could emit malformed JSON.
escIdent: function [s][
    if contains? s SJB -> return jsonEscape s
    if contains? s SJQ -> return jsonEscape s
    s
]

emitDict: function [v][
    ks: keys v
    parts: []
    i: 0
    n: size ks
    while [i < n][
        k: ks\[i]
        parts: append parts @["[" ++ (qs k) ++ "," ++ (emitItem v\[k]) ++ "]"]
        i: i + 1
    ]
    {["d",[} ++ (join.with: "," parts) ++ "]]"
]

;; everything else crosses as an opaque leaf: a tag and whatever rendering
;; the type has, which some of them do not. A sixth of the corpus arrives
;; here, so guarding every one of them with a `try` costs a scope apiece.
;;
;; Four kinds refuse `to :string` on 0.10.0, and they are known by name
;; rather than discovered by catching: `:inline`, `:path`, `:pathlabel` and
;; `:pathliteral`. They cross with an empty rendering, which is what the
;; caught version produced for them anyway.
NOSTR: #[]
loop ["inline" "path" "pathlabel" "pathliteral"] 'k -> NOSTR\[to :type k]: true

;; A kind that is not on that list and still refuses is a version of Arturo
;; this list has not met. `emitInput` catches that, turns this flag on, and
;; emits the whole input again through the guarded form, so the list being
;; incomplete costs one re-emission rather than a failed scan.
OPQ: #[safe: false]

emitOpaqueSafe: function [v][
    r: ""
    e: try [ r: to :string v ]
    {["o",} ++ (qs to :string type v) ++ "," ++ (qs r) ++ "]"
]

emitOpaque: function [v][
    if OPQ\safe -> return emitOpaqueSafe v
    if key? NOSTR type v -> return {["o",} ++ (qs to :string type v) ++ {,""]}
    {["o",} ++ (qs to :string type v) ++ "," ++ (qs to :string v) ++ "]"
]

;; Nothing here is assigned to a local, and the type is re-read per test
;; rather than held in one. The two are the same trade: a body that assigns
;; costs a scope, about 7 microseconds a call, while `type v` costs about
;; eight nanoseconds, so fourteen of them are still four hundred times
;; cheaper than the local that would have saved them. The dictionary and
;; opaque cases need locals and are rare, so they are functions of their own
;; and pay the scope only when they are reached.
;;
;; An identifier's text is the whole of what it emits, so the same word
;; emits the same JSON every time it appears. Arturo's own source holds
;; 45,487 words and 911 distinct ones, and 28,758 symbols and 91 distinct
;; ones, so emitting each spelling once and remembering it removes most of
;; the work. A word is usable as a dictionary key directly, which is why
;; there is no conversion here. One cache per kind, because a label and a
;; word spelled alike would key alike and emit differently.
WCACHE: #[]
YCACHE: #[]
LCACHE: #[]
QCACHE: #[]

emitItem: function [v][
    if (type v) = TWORD [
        unless key? WCACHE v [ WCACHE\[v]: {["w","} ++ (escIdent to :string v) ++ {"]} ]
        return WCACHE\[v]
    ]
    if (type v) = TSTR   -> return {["s","} ++ (jsonEscape v) ++ {"]}
    if (type v) = TBLOCK -> return {["b",[} ++ (join.with: "," map v 'e -> emitItem e) ++ "]]"
    if (type v) = TSYM [
        unless key? YCACHE v [ YCACHE\[v]: {["y","} ++ (escIdent to :string v) ++ {"]} ]
        return YCACHE\[v]
    ]
    if (type v) = TLABEL [
        unless key? LCACHE v [ LCACHE\[v]: {["l","} ++ (escIdent to :string v) ++ {"]} ]
        return LCACHE\[v]
    ]
    if (type v) = TINT   -> return {["i",} ++ (to :string v) ++ "]"
    if (type v) = TLIT [
        unless key? QCACHE v [ QCACHE\[v]: {["t","} ++ (escIdent to :string v) ++ {"]} ]
        return QCACHE\[v]
    ]
    if (type v) = TTYPE  -> return {["T",":} ++ (to :string v) ++ {"]}
    if (type v) = TCHAR  -> return {["c",} ++ (to :string to :integer v) ++ "]"
    if (type v) = TSYML  -> return {["q","} ++ (escIdent to :string v) ++ {"]}
    if (type v) = TFLOAT -> return {["f",} ++ (to :string v) ++ "]"
    if (type v) = TLOG   -> return {["g",} ++ ((v)? -> "true" -> "false") ++ "]"
    if (type v) = TNULL  -> return {["n",""]}
    if (type v) = TDICT  -> return emitDict v
    emitOpaque v
]

;; ── the library ──────────────────────────────────────────────────────

LIB: #[p: ""]

;; the library is built one level up from this file, so the path is derived
;; rather than configured; assign LIB\p to point somewhere else
carpinteroLib: function [][
    if LIB\p = "" [ LIB\p: relative "../libcarpintero.dylib" ]
    LIB\p
]

;; ── scanning ─────────────────────────────────────────────────────────

;; the library caches one compiled program per distinct grammar string, so
;; the text is built once per grammar on this side too
GJ: #[]

grammarJson: function [rule][
    k: to :string rule
    unless key? GJ k [ GJ\[k]: jsonString grammarTree rule ]
    GJ\[k]
]

;; walk a path of into-descent indices to the block a span refers to
spanSource: function [input path][
    src: input
    i: 0
    n: size path
    while [i < n][
        src: src\[path\[i]]
        i: i + 1
    ]
    src
]

spanValue: function [input isblk span][
    src: spanSource input span\path
    f: span\from
    t: span\to
    if f = t -> return (isblk)? -> [] -> ""
    ; slice of a string is a string and slice of a block is a block, which
    ; is what scan returns for each input kind
    slice src f t - 1
]

emitInput: function [input isblk][
    (isblk)? -> {["block",[} ++ (join.with: "," map input 'e -> emitItem e) ++ "]]"
             -> {["text",} ++ (SJQ ++ (jsonEscape input) ++ SJQ) ++ "]"
]

;; scanFast: the contract scan has, a dictionary of captures or null.
scanFast: function [input rule][
    isblk: block? input
    inp: ""
    ; the only way this fails is a kind NOSTR has not met; see there
    err: try [ inp: emitInput input isblk ]
    unless null? err [
        OPQ\safe: true
        inp: emitInput input isblk
    ]

    reply: call.external: carpinteroLib
                .expect: :string
                'cpScan @[grammarJson rule  inp]

    r: read.json.string reply
    if key? r 'error [ panic ~"carpintero (compiled): |r\error|" ]
    unless r\ok -> return null

    ;; captures arrive as an array in the order they closed, which is the
    ;; order the interpreted matcher reports them in
    out: #[]
    caps: r\captures
    i: 0
    n: size caps
    while [i < n][
        c: caps\[i]
        nm: c\name
        if key? c 'items [ out\[nm]: map c\items 's -> spanValue input isblk s ]
        unless key? c 'items [ out\[nm]: spanValue input isblk c\span ]
        i: i + 1
    ]
    out
]
