;; cases.art — generate the differential corpus.
;;
;;     arturo nim/adapter/cases.art nim/adapter/cases.json
;;
;; Each case is a grammar, an input, and what the interpreted matcher made
;; of the two. The Nim runner reruns the grammar against the input and
;; checks that it agrees. Cases are written here rather than in Nim so that
;; the interpreted side, which is the specification, is the one that decides
;; what the answer is.

import ./"export.art"!

digit: charset "0-9"
lower: charset "a-z"
alnum: csUnion digit lower

date:  [capture 'year [4 digit] "-" capture 'month [2 digit] "-" capture 'day [2 digit]]
word:  [some lower]
words: [collect 'words [some [keep word | skip]]]

defn: [:label 'function :block]
walk: [any [keep defn | into walk | skip]]

CASES: @[
    ;; terminals and quantifiers
    caseTree "literal"          ["hello"]                      "hello"
    caseTree "literal-short"    ["hello"]                      "hell"
    caseTree "literal-long"     ["hello"]                      "helloo"
    caseTree "charset"          [some digit]                   "12345"
    caseTree "charset-empty"    [some digit]                   ""
    caseTree "charset-union"    [some alnum]                   "a1b2"
    caseTree "exactly-n"        [4 digit]                      "2026"
    caseTree "exactly-n-short"  [4 digit]                      "202"
    caseTree "between"          [between 2 4 digit]            "123"
    caseTree "between-under"    [between 2 4 digit]            "1"
    caseTree "between-over"     [between 2 4 digit]            "12345"
    caseTree "any-none"         [any digit]                    ""
    caseTree "skip-end"         [skip end]                     "z"

    ;; ordered choice, and the pitfalls the manual documents
    caseTree "hidden-prefix"    ["a" | "ab"]                   "ab"
    caseTree "longest-first"    ["ab" | "a"]                   "ab"
    caseTree "backtrack-arm"    ["ab" "c" | "ab" "d"]          "abd"
    caseTree "greedy-no-give"   [some "a" "a"]                 "aaa"

    ;; lookahead
    caseTree "not"              [not digit skip]               "x"
    caseTree "not-fails"        [not digit skip]               "5"
    caseTree "ahead"            [ahead "ab" "abc"]             "abc"
    caseTree "ahead-captures"   [ahead [capture 'peek "ab"] "abc"]  "abc"
    caseTree "not-discards"     [not [capture 'nope "zz"] "abc"]    "abc"

    ;; advance
    caseTree "to"               [capture 'h to "," skip any skip]   "abc,def"
    caseTree "thru"             [capture 'h thru "," any skip]      "abc,def"

    ;; captures, and the rollback that diverges from Rebol
    caseTree "date"             date                           "2026-08-03"
    caseTree "date-bad"         date                           "2026-08-0x"
    caseTree "nested-capture"   [capture 'outer [capture 'inner "a" "b"]]  "ab"
    caseTree "repeated-capture" [some [capture 'c skip]]       "aaab"
    caseTree "dead-capture"     [capture 'x "ab" "!" | capture 'y "abc"]   "abc"
    caseTree "empty-capture"    [capture 'e []]                ""

    ;; the progress guard, and what a stalled iteration must not leave
    caseTree "guard-any"        [any [opt "a"] "xy"]           "xy"
    caseTree "guard-capture"    [some [capture 'x opt "a"]]    "a"
    caseTree "guard-keep"       [collect 'c [some [keep [opt skip]]]]      "ab"
    ;; the stall on the first iteration rather than the tail, which is
    ;; where the two engines parted company until the early return in
    ;; matchMany unwound its log like every other exit does
    caseTree "guard-keep-first" [collect 'c [any [keep end]]]              ""
    caseTree "guard-keep-null"  [collect 'c [any [keep opt "z"]]]          ""
    caseTree "guard-cap-first"  [any [capture 'x end]]                     ""
    ;; the counted forms, which carry no guard because a bound already
    ;; terminates them, and which have to agree with each other
    caseTree "count-exact-null" [2 end]                                    ""
    caseTree "count-btw-null"   [between 2 2 end]                          ""
    caseTree "count-btw-keep"   [collect 'c [between 0 3 [keep end]]]      ""
    caseTree "count-btw-real"   [between 2 4 "a"]                          "aaa"
    ;; the empty string is a zero-width match against text and an element
    ;; against a block, and one compiled program serves both
    caseTree "empty-str-text"   [""]                                       ""
    caseTree "empty-str-text-a" ["" "a"]                                   "a"
    caseTree "empty-str-none"   [""]                                       []
    caseTree "empty-str-elem"   [""]                                       @[""]
    caseTree "empty-str-other"  [""]                                       @["a"]
    caseTree "empty-str-skip"   ["" skip]                                  @["a"]
    ;; an alternative whose cut is never reached must not commit the block.
    ;; These looked like a cut bug for as long as the empty string above
    ;; matched vacuously here: it reached the cut, the cut committed, and
    ;; the arm then failed with nowhere to go.
    caseTree "cut-unreached"    [["" cut skip | cut]]                      []
    caseTree "cut-unreached-2"  [["" cut 'greet | cut]]                    []
    caseTree "cut-unreached-t"  [["z" cut skip | cut]]                     ""

    ;; whether a name that matched nothing is bound at all. A collect that
    ;; ran and kept nothing binds an empty block; one in an alternative
    ;; that failed binds nothing, which is not the same answer.
    caseTree "bind-coll-none"   [collect 'k [any [keep "z"]]]              ""
    caseTree "bind-coll-dead"   [collect 'k [any [keep "a"]] "z" | "a"]    "a"
    caseTree "bind-coll-ahead"  [ahead collect 'k [any [keep "z"]] "a"]    "a"
    caseTree "bind-coll-same"   [collect 'k [any [keep collect 'k [any [keep "a"]]]]]  "a"
    caseTree "bind-coll-into"   [into [collect 'k [any [keep "z"]]]]       [[]]
    caseTree "bind-cap-opt"     [capture 'c opt "z"]                       ""
    caseTree "bind-cap-dead"    [capture 'c "a" "z" | "a"]                 "a"

    ;; the mandatory pass of some against the optional first pass of any
    caseTree "some-mandatory"   [collect 'c [some [keep end]]]             ""
    caseTree "some-vs-exact"    [collect 'c [1 [keep end]]]                ""
    caseTree "some-cap-empty"   [some capture 'x ""]                       ""
    caseTree "any-no-pass"      [collect 'c [any [keep end]]]              ""

    ;; collect and keep
    caseTree "words"            words                          "one, two, three"
    caseTree "collect-empty"    [collect 'c [any [keep digit | skip]]]     "abc"

    ;; cut
    caseTree "cut-commits"      ["a" cut "b" | "a" "c"]        "ac"
    caseTree "cut-succeeds"     ["a" cut "b" | "a" "c"]        "ab"
    caseTree "no-cut"           ["a" "b" | "a" "c"]            "ac"
    caseTree "cut-nested-group" [["a" cut "b"] "c" | "a" "b" "z"]  "abz"

    ;; block input
    caseTree "type-term"        [:integer]                     @[42]
    caseTree "type-mismatch"    [:integer]                     @["42"]
    caseTree "word-term"        ['function]                    @[first [function]]
    caseTree "word-vs-label"    ['greet]                       @[first [greet:]]
    caseTree "string-element"   ["ab"]                         @["ab"]
    caseTree "into-full"        [into [:integer :integer]]     [[1 2]]
    caseTree "into-partial"     [into [:integer :integer]]     [[1 2 3]]
    caseTree "into-capture"     [into [capture 'inner [:integer :integer]]]  [[7 8]]
    caseTree "into-deep-fail"   [skip into [:integer :string]] [0 [1 2]]

    ;; matching Arturo source, which is the reason the dialect exists
    caseTree "funcdef"          [capture 'name :label 'function capture 'params :block capture 'body :block]
                                [greet: function [name] [print name]]
    caseTree "walk-nested"      [collect 'defs walk]
                                [outer: function [] [inner: function [] []]]
    caseTree "walk-flat"        [collect 'defs walk]
                                [a: function [] [] b: function [] []]
]

out: (empty? arg)? -> "nim/adapter/cases.json" -> last arg
discard writeCases out CASES
print ["wrote" size CASES "cases to" out]
