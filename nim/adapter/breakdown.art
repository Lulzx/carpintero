;; breakdown.art — where the FFI path actually spends its time.
;;
;;     arturo nim/adapter/breakdown.art ../arturo
import ./"fast.art"!

defn:  [capture 'name :label ['function | 'method | quote $] opt :attribute capture 'params :block]
walk:  [any [ keep defn | into walk | skip ]]
allDefns: [collect 'found walk]

root: first arg
files: select list.recursive.relative root 'f -> "art" = last split.by:"." f
blocks: []
i: 0
n: size files
while [i < n][
    blk: []
    ok: false
    e: try [ blk: loadSafe root ++ "/" ++ files\[i]  ok: true ]
    if ok [ blocks: append blocks @[blk] ]
    i: i + 1
]
print ~"corpus: |size blocks| files"

T: #[n: 0]
tEmit: benchmark.get [
    j: 0
    m: size blocks
    while [j < m][
        discard {["block",[} ++ (join.with: "," map blocks\[j] 'e -> emitItem e) ++ "]]"
        j: j + 1
    ]
]
inputs: map blocks 'b -> {["block",[} ++ (join.with: "," map b 'e -> emitItem e) ++ "]]"
gj: grammarJson allDefns

tCall: benchmark.get [
    j: 0
    m: size inputs
    while [j < m][
        discard call.external: carpinteroLib .expect: :string 'cpScan @[gj inputs\[j]]
        j: j + 1
    ]
]

;; the old path, for comparison: tagged dictionaries then a character-by-
;; character escaper
tOld: benchmark.get [
    j: 0
    m: size blocks
    while [j < m][
        discard jsonString #[kind: "block" v: map blocks\[j] 'e -> itemTree e]
        j: j + 1
    ]
]

print ["  emitItem (values straight to text):" tEmit]
print ["  the call, matching included:       " tCall]
print ["  for comparison, itemTree+jsonString:" tOld]
