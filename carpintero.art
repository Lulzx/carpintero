;; carpintero.art — draft of the PARSE-class grammar dialect proposed
;; in proposal.md, covering the Phase 0 through Phase 2 scope:
;; quantifiers with a progress guard, ordered choice, captures with
;; rollback, charsets, named and recursive rules, left-recursion
;; rejection, block matching with type and literal-word terminals plus
;; quote, lookahead with ahead and not, collect and keep, the do host
;; escape, fail with a message, and farthest-failure error reporting
;; through scanError — plus the interpreted half of the Phase 3 scope:
;; cut, the deferred commit-time escape, and opt-in per-rule
;; memoization through the memo attribute.
;;
;; Grammar elements understood by the matcher:
;;   string and char literals
;;   charsets from the charset function, with ranges such as a-z and
;;     a backslash before a dash for a literal dash
;;   blocks as sequences, the bar symbol for ordered alternatives
;;   some R, any R, opt R, N R, between N M R
;;   to R, thru R, skip, end
;;   capture with a literal name and a rule
;;   into R, matching a nested block in its entirety with rule R
;;   any other word: a named rule, resolved when scan runs
;;
;; Three workarounds for Arturo 0.10.0 interpreter quirks, found while
;; writing this file, each expressed with a feature of the language:
;;   1. comments avoid quote marks, brackets and backslashes, since the
;;      lexer does not fully ignore comment contents — a backslash-dash
;;      in a comment hangs it. This file keeps its comments plain, and
;;      exports the general fix: loadSafe strips comments from source
;;      at the string level, before the lexer sees a byte of them,
;;      using a Carpintero grammar — see comment-safe source loading
;;      at the end of this file.
;;   2. every call whose result is unused goes through discard: a
;;      dropped call result can otherwise leak into the argument
;;      stream of an enclosing call
;;   3. escape blocks are evaluated as op ++ [true]: do of a block
;;      whose last expression produces no value corrupts the
;;      enclosing frame, and the padding guarantees a value tail
;;
;; ── on speed ─────────────────────────────────────────────────────────
;; This is an interpreted matcher and the proposal is honest about
;; where that puts it. Six decisions carry most of the difference
;; between the naive tree walk and what is here, and each one is marked
;; at its site below:
;;   S1  string input is converted to a block of characters once, at
;;       scan start. Indexing an Arturo string by position walks the
;;       UTF-8 from the front, so the naive matcher is quadratic in the
;;       length of the input; indexing a block is constant time.
;;   S2  charsets carry a 128-entry lookup table for the ASCII range,
;;       so the common terminal is one index instead of a walk over
;;       ranges.
;;   S3  grammar words dispatch through one dictionary lookup into an
;;       integer opcode, and a named rule is the cheap case rather
;;       than the twenty-string-comparison case.
;;   S4  named rules resolve through the table the pre-pass already
;;       built, and terminals reached through a rule name are matched
;;       directly, with no wrapper block allocated per invocation.
;;   S5  the stacks the error report needs — enclosing rules, terminal
;;       names, cut frames — are blocks with a separate depth counter,
;;       pushed by overwriting rather than by appending.
;;   S6  every matcher function that assigns a local is declared
;;       inline, because a scoped Arturo call that assigns anything at
;;       all costs about twenty times one that does not. An inline
;;       body runs in its caller scope, so their locals are prefixed
;;       per function and none of them is read after a call that could
;;       re-enter it. matchElem keeps a scope of its own, and that is
;;       what makes the rest safe: it stands between any two nested
;;       invocations of the same inline function, so no two live
;;       instances ever share a scope.
;; Failure descriptions are built only on the failure path, which
;; matters because most terminal attempts in a backtracking parse fail.

;; ── charsets ─────────────────────────────────────────────────────────

;; S2: every charset carries ascii, a 128-entry membership table. Code
;; points above 127 fall back to the range walk, so the table is an
;; index for the common case and never a limit on what a set can hold.
csMake: function [spec ranges][
    asc: array.of: 128 false
    unless empty? ranges [
        loop ranges 'r [
            lo: r\0
            if lo < 128 [
                hi: (r\1 > 127)? -> 127 -> r\1
                i: lo
                while [i =< hi][
                    asc\[i]: true
                    i: i + 1
                ]
            ]
        ]
    ]
    #[kind: 'charset  spec: spec  ranges: ranges  ascii: asc]
]

charset: function [spec][
    ranges: []
    n: size spec
    i: 0
    while [i < n][
        c: spec\[i]
        done: false
        ; escaped dash: backslash before dash 92 = backslash
        if and? (c = to :char 92) ((i + 1) < n) [
            if (spec\[i + 1]) = '-' [
                ranges: append ranges @[@[45 45]]
                i: i + 2
                done: true
            ]
        ]
        ; range c-h: dash flanked on both sides
        if and? (not? done) ((i + 2) < n) [
            if (spec\[i + 1]) = '-' [
                lo: to :integer c
                hi: to :integer spec\[i + 2]
                if hi < lo -> panic ~"carpintero: inverted charset range in |spec|"
                ranges: append ranges @[@[lo hi]]
                i: i + 3
                done: true
            ]
        ]
        unless done [
            cp: to :integer c
            ranges: append ranges @[@[cp cp]]
            i: i + 1
        ]
    ]
    csMake spec ranges
]

;; charsets are values and compose. The plain words union and
;; intersection belong to core, for blocks, so these carry a cs prefix.

csUnion: function [a b][
    csMake ~"|a\spec|+|b\spec|" a\ranges ++ b\ranges
]

csIntersect: function [a b][
    out: []
    unless empty? a\ranges [
        loop a\ranges 'ra [
            unless empty? b\ranges [
                loop b\ranges 'rb [
                    lo: (ra\0 > rb\0)? -> ra\0 -> rb\0
                    hi: (ra\1 < rb\1)? -> ra\1 -> rb\1
                    if lo =< hi [ out: append out @[@[lo hi]] ]
                ]
            ]
        ]
    ]
    csMake ~"|a\spec|&|b\spec|" out
]

;; selection sort by low bound, since core sort has no order guarantee
;; on nested blocks
csSortRanges: function [ranges][
    n: size ranges
    used: []
    loop 1..n 'k [ used: append used false ]
    out: []
    cnt: 0
    while [cnt < n][
        bi: n
        i: 0
        while [i < n][
            unless used\[i] [
                if bi = n -> bi: i
                if (ranges\[i]\0) < (ranges\[bi]\0) -> bi: i
            ]
            i: i + 1
        ]
        used\[bi]: true
        out: append out @[ranges\[bi]]
        cnt: cnt + 1
    ]
    out
]

csComplement: function [cs][
    sorted: csSortRanges cs\ranges
    out: []
    prev: 0
    unless empty? sorted [
        loop sorted 'r [
            if r\0 > prev [ out: append out @[@[prev r\0 - 1]] ]
            if (r\1 + 1) > prev -> prev: r\1 + 1
        ]
    ]
    if prev < 1114112 [ out: append out @[@[prev 1114111]] ]
    csMake ~"not |cs\spec|" out
]

csMatch?: function.inline [cmCs cmC][
    cmCp: to :integer cmC
    if cmCp < 128 -> return cmCs\ascii\[cmCp]
    cmRs: cmCs\ranges
    cmN: size cmRs
    cmI: 0
    while [cmI < cmN][
        cmR: cmRs\[cmI]
        if and? (cmCp >= cmR\0) (cmCp =< cmR\1) -> return true
        cmI: cmI + 1
    ]
    false
]

;; ── matcher state ────────────────────────────────────────────────────
;; One global record, mutated in place. The capture log holds triples
;; of name, start and end; values materialize only on overall success,
;; and rollback is truncation — see Backtracking semantics in the
;; proposal.
;;
;; S1: inp is always a block. Block input is itself; string input is
;; converted to a block of characters once, at scan start, because
;; indexing an Arturo string by position is linear in the position —
;; the matcher indexes constantly, so on a string it would be
;; quadratic in the length of the input. Captures over string input
;; join their slice back into a string on the way out.
;;
;; S5: rules, dsc and cuts are stacks kept as a block plus a depth,
;; pushed by overwriting a slot when one is free. Appending and
;; chopping would allocate on every named rule and every choice block.
CS: #[inp: []  len: 0  log: []  isblk: false  farpath: []  exp: []  coldepth: 0
      rules: []  nrules: 0  dscw: ""  ctx: ""  quiet: 0  path: []
      cuts: []  ncuts: 0  reg: #[]]

;; per-scan memoization state: rules holds the names opted in through
;; scan.memo, tab the results keyed by rule name, descent path and
;; position — see No packrat memoization in the proposal. on is the
;; guard that keeps an unmemoized scan out of the lookup entirely.
MC: #[on: false  rules: []  tab: #[]]

;; literal strings compared against character input, cached as blocks
;; of characters so the comparison is index against index
LITS: #[]

litChars: function.inline [lcS][
    if key? LITS lcS -> return LITS\[lcS]
    lcB: map lcS 'c -> c
    LITS\[lcS]: lcB
    lcB
]

;; record a terminal failure for the farthest-failure error report,
;; then fail — see Error reporting in the proposal. Three refinements
;; over the bare high-water mark:
;;   dscw, the name of the terminal rule being matched, so a charset
;;     failing inside the rule digit reports the word digit and not
;;     its internals. One slot rather than a stack: the value of a
;;     terminal rule is a terminal, so it never invokes another rule
;;     and the nesting never reaches two. It holds the rule word
;;     unconverted, and only the failure path pays for the name
;;   rules, a stack of enclosing block rules and capture names, whose
;;     top becomes the while-matching context of the report
;;   quiet, a counter that suppresses recording inside the operand of
;;     not, whose failures are the grammar succeeding
;; a failure position is the into descent path plus the index, and
;; farther means lexicographically later, deeper on ties — so failing
;; inside element 2 beats failing at element 2, and either loses to
;; failing at element 3
FARTHER: 2
SAMEPOS: 1
NEARER:  0

;; What a terminal was, passed to failAt as a kind and the value
;; itself. Rendering it costs an interpolation, and most failures are
;; behind the high-water mark and never reported, so the description is
;; built only once failAt has decided to keep it.
DTEXT:  0
DLIT:   1
DCSET:  2
DCHAR:  3
DTYPE:  4
DWORD:  5

failDesc: function.inline [fdKind fdVal][
    if fdKind = DLIT  -> return ~"literal |fdVal|"
    if fdKind = DCSET -> return ~"charset |fdVal\spec|"
    if fdKind = DCHAR -> return ~"char |fdVal|"
    if fdKind = DTYPE -> return to :string fdVal
    if fdKind = DWORD -> return ~"word |to :string fdVal|"
    fdVal
]

cmpPath: function.inline [cpA cpB][
    cpNa: size cpA
    cpNb: size cpB
    cpI: 0
    while [and? [cpI < cpNa] [cpI < cpNb]][
        if (cpA\[cpI]) > (cpB\[cpI]) -> return FARTHER
        if (cpA\[cpI]) < (cpB\[cpI]) -> return NEARER
        cpI: cpI + 1
    ]
    if cpNa > cpNb -> return FARTHER
    if cpNa < cpNb -> return NEARER
    SAMEPOS
]

failAt: function.inline [faPos faKind faVal][
    if CS\quiet > 0 -> return null
    ; the flat case — no into descent in progress and none recorded —
    ; is the whole of string scanning and most of block scanning, and
    ; it compares two integers instead of building and ordering paths
    if and? (empty? CS\path) ((size CS\farpath) < 2) [
        faHad: not? empty? CS\farpath
        faFar: (faHad)? -> CS\farpath\[0] -> (0 - 1)
        if faPos < faFar -> return null
        faShown: (CS\dscw = "")? -> (failDesc faKind faVal) -> to :string CS\dscw
        if faPos > faFar [
            if faHad [ CS\farpath\[0]: faPos ]
            unless faHad [ CS\farpath: @[faPos] ]
            CS\exp: []
        ]
        if empty? CS\exp [
            CS\ctx: (CS\nrules = 0)? -> "" -> CS\rules\[CS\nrules - 1]
        ]
        unless in? faShown CS\exp [ CS\exp: append CS\exp faShown ]
        return null
    ]
    faShown: (CS\dscw = "")? -> (failDesc faKind faVal) -> to :string CS\dscw
    faFp: CS\path ++ @[faPos]
    faC: cmpPath faFp CS\farpath
    if faC = FARTHER [
        CS\farpath: faFp
        CS\exp: []
    ]
    unless faC = NEARER [
        if empty? CS\exp [
            CS\ctx: (CS\nrules = 0)? -> "" -> CS\rules\[CS\nrules - 1]
        ]
        unless in? faShown CS\exp [ CS\exp: append CS\exp faShown ]
    ]
    null
]

;; ── rule structure ───────────────────────────────────────────────────
;; S3: one dictionary from grammar word to opcode, in rough order of
;; how often the matcher meets each. A word absent from it is a named
;; rule, which is the case the dispatch reaches first and cheapest.

KWCODE: #[
    "skip":    1   "some":  2   "any":    3   "opt":   4   "capture": 5
    "not":     6   "ahead": 7   "to":     8   "thru":  9   "end":    10
    "keep":   11   "collect": 12  "into": 13   "between": 14
    "do":     15   "defer": 16  "cut":   17   "quote": 18  "fail":   19
]

;; the reserved vocabulary, for anyone who needs to ask whether a word
;; is one — derived, so it cannot drift from what the matcher dispatches
KEYWORDS: keys KWCODE

;; how many items past its own word each keyword occupies, as a code:
;;   0  the word alone
;;   1  the word and one rule element
;;   2  a name and one rule element
;;   3  two bounds and one rule element
;;   4  the word and one literal value
SPANKIND: [0 0 1 1 1 2 1 1 1 1 0 1 2 1 3 4 4 0 4 4]

;; number of items the element starting at idx occupies
;; inline and self-recursive at once: the recursive call is the last
;; thing the body does with its own names, so an inner invocation
;; overwriting them is harmless
elemSpan: function.inline [esItems esIdx][
    esIt: esItems\[esIdx]
    if integer? esIt -> return 1 + elemSpan esItems esIdx + 1
    unless word? esIt -> return 1
    unless key? KWCODE esIt -> return 1
    esKd: SPANKIND\[KWCODE\[esIt]]
    if esKd = 0 -> return 1
    if esKd = 1 -> return 1 + elemSpan esItems esIdx + 1
    if esKd = 2 -> return 2 + elemSpan esItems esIdx + 2
    if esKd = 3 -> return 3 + elemSpan esItems esIdx + 3
    2
]

;; the bar that separates alternatives, as a value, so splitting a
;; block compares symbols instead of rendering each one to a string
BAR: first [|]

;; ── the matcher ──────────────────────────────────────────────────────
;; Every match* function returns the new input position, or null on
;; failure.
;;
;; The capture log rolls back at the points where a failure is
;; swallowed and matching carries on — a failed alternative in a
;; choice, a failed iteration of a repetition, a probe of to or thru,
;; the operand of opt, the operand of not. Everywhere else a failure
;; propagates, and the roll-back happens at whichever of those points
;; catches it, so an element in a sequence needs no wrapper of its own.
;; That is the difference between one interpreted call per element and
;; two, on the hottest path there is.

;; A position is never negative, so this can stand for the answer
;; matchOne gives when the element is not one it handles.
NOTSIMPLE: 0 - 2

;; The fast path off matchElem, for the elements that make up most of
;; a grammar: a literal, a charset, a character, a type or word
;; terminal, or a rule name standing for one of those. None of them
;; can recurse and none of them writes to the capture log, so this
;; needs neither a scope nor a rollback, and the element is matched
;; without the interpreter building a frame for it. Anything else
;; comes back as NOTSIMPLE and goes the long way round.
matchOne: function.inline [oItems oIdx oPos][
    oIt: oItems\[oIdx]
    if word? oIt [
        if key? KWCODE oIt -> return NOTSIMPLE
        ; a memoized rule has to go through the table, so it takes the
        ; long way; the rest of the grammar keeps the fast path
        if MC\on [
            if in? to :string oIt MC\rules -> return NOTSIMPLE
        ]
        unless key? CS\reg oIt -> return NOTSIMPLE
        oV: CS\reg\[oIt]
        if block? oV -> return NOTSIMPLE
        oOld: CS\dscw
        CS\dscw: oIt
        oP: matchValue oV oPos
        CS\dscw: oOld
        return oP
    ]
    if integer? oIt -> return NOTSIMPLE
    if block? oIt -> return NOTSIMPLE
    matchValue oIt oPos
]

;; a terminal value, matched directly. Split out from matchElem so
;; that a rule name standing for a terminal reaches it without the
;; matcher allocating a one-element block to hold the value (S4).
;; Nothing here writes to the capture log, so none of it needs the
;; rollback wrapper either.
matchValue: function.inline [vIt vPos][
    if string? vIt [
        if CS\isblk [
            if vPos < CS\len [
                vEl: CS\inp\[vPos]
                if and? (string? vEl) (vEl = vIt) -> return vPos + 1
            ]
            return failAt vPos DLIT vIt
        ]
        vN: size vIt
        if vN = 0 -> return vPos
        if (vPos + vN) =< CS\len [
            if vN = 1 [
                if (CS\inp\[vPos]) = vIt\[0] -> return vPos + 1
                return failAt vPos DLIT vIt
            ]
            vLit: litChars vIt
            vJ: 0
            while [vJ < vN][
                unless (CS\inp\[vPos + vJ]) = vLit\[vJ] -> return failAt vPos DLIT vIt
                vJ: vJ + 1
            ]
            return vPos + vN
        ]
        return failAt vPos DLIT vIt
    ]
    if dictionary? vIt [
        if vPos < CS\len [
            vEl: CS\inp\[vPos]
            if CS\isblk [
                unless char? vEl -> return failAt vPos DCSET vIt
            ]
            ; S2 inline: the ASCII table settles the common terminal
            ; without a call
            vCp: to :integer vEl
            vOk: (vCp < 128)? -> vIt\ascii\[vCp] -> csMatch? vIt vEl
            if vOk -> return vPos + 1
        ]
        return failAt vPos DCSET vIt
    ]
    if block? vIt -> return matchBlock vIt vPos
    if char? vIt [
        if vPos < CS\len [
            if (CS\inp\[vPos]) = vIt -> return vPos + 1
        ]
        return failAt vPos DCHAR vIt
    ]
    if type? vIt [
        unless CS\isblk -> panic "carpintero: type terminals need block input"
        if vPos < CS\len [
            if (type CS\inp\[vPos]) = vIt -> return vPos + 1
        ]
        return failAt vPos DTYPE vIt
    ]
    if literal? vIt [
        unless CS\isblk -> panic "carpintero: literal word terminals need block input"
        if vPos < CS\len [
            vEl: CS\inp\[vPos]
            if word? vEl [
                if (to :string vEl) = to :string vIt -> return vPos + 1
            ]
        ]
        return failAt vPos DWORD vIt
    ]
    ; Nothing matched. vIt is deliberately not interpolated into the
    ; message: a value that reaches here can be a function, and merely
    ; naming a word bound to a function calls it, so the report would
    ; disappear into a not-enough-parameters error raised inside the
    ; callee. dscw is a string and names the rule this came through,
    ; which is the useful half anyway. The common cause of this, a
    ; constructor call inlined into a rule, is caught earlier and more
    ; precisely by collectRules.
    panic "carpintero: unexpected item in rule, reached through the rule word '" ++ (to :string CS\dscw) ++ "'"
]

matchElem: function [items idx pos][
    it: items\[idx]

    if word? it [
        ; a named rule, the single dispatch point the proposal keeps
        ; for opt-in memoization. Resolution goes through the table the
        ; pre-pass built, and a rule standing for a terminal is matched
        ; without a wrapper block being allocated to carry it (S4).
        unless key? KWCODE it [
            if MC\on [
                ws: to :string it
                if in? ws MC\rules -> return matchNamedMemo ws pos
            ]
            unless key? CS\reg it [
                panic ~"carpintero: unbound rule word '|to :string it|'"
            ]
            v: CS\reg\[it]
            if block? v [
                if CS\nrules < size CS\rules [ CS\rules\[CS\nrules]: it ]
                unless CS\nrules < size CS\rules [ CS\rules: append CS\rules it ]
                CS\nrules: CS\nrules + 1
                p: matchBlock v pos
                CS\nrules: CS\nrules - 1
                return p
            ]
            old: CS\dscw
            CS\dscw: it
            p: matchValue v pos
            CS\dscw: old
            return p
        ]
        k: KWCODE\[it]

        if k = 1 -> return (pos < CS\len)? -> pos + 1 -> failAt pos DTEXT "any value"
        if k = 2 -> return matchMany items idx + 1 pos true
        if k = 3 -> return matchMany items idx + 1 pos false
        if k = 4 [
            sz: size CS\log
            p: matchOne items idx + 1 pos
            if p = NOTSIMPLE -> p: matchElem items idx + 1 pos
            if null? p [
                if (size CS\log) > sz [
                    CS\log: (sz = 0)? -> [] -> slice CS\log 0 sz - 1
                ]
                return pos
            ]
            return p
        ]
        if k = 5 [
            nm: items\[idx + 1]
            unless literal? nm [
                panic "carpintero: capture expects a literal name, as in: capture 'year rule"
            ]
            nms: to :string nm
            if CS\nrules < size CS\rules [ CS\rules\[CS\nrules]: nms ]
            unless CS\nrules < size CS\rules [ CS\rules: append CS\rules nms ]
            CS\nrules: CS\nrules + 1
            p: matchElem items idx + 2 pos
            CS\nrules: CS\nrules - 1
            if null? p -> return null
            CS\log: append CS\log @[@["cap" nms pos p CS\inp]]
            return p
        ]
        if k = 6 [
            CS\quiet: CS\quiet + 1
            sz: size CS\log
            p: matchElem items idx + 1 pos
            CS\quiet: CS\quiet - 1
            ; either way the operand leaves nothing behind: it failed,
            ; or it succeeded and not fails on its account
            if (size CS\log) > sz [
                CS\log: (sz = 0)? -> [] -> slice CS\log 0 sz - 1
            ]
            return (null? p)? -> pos -> null
        ]
        if k = 7 [
            p: matchElem items idx + 1 pos
            return (null? p)? -> null -> pos
        ]
        if k = 8 -> return matchScan items idx + 1 pos false
        if k = 9 -> return matchScan items idx + 1 pos true
        if k = 10 -> return (pos = CS\len)? -> pos -> failAt pos DTEXT "end of input"
        if k = 11 [
            if CS\coldepth = 0 -> panic "carpintero: keep outside collect"
            p: matchElem items idx + 1 pos
            if null? p -> return null
            CS\log: append CS\log @[@["keep" "" pos p CS\inp]]
            return p
        ]
        if k = 12 [
            nm: items\[idx + 1]
            unless literal? nm [
                panic "carpintero: collect expects a literal name, as in: collect 'items rule"
            ]
            CS\log: append CS\log @[@["copen" to :string nm 0 0]]
            CS\coldepth: CS\coldepth + 1
            p: matchElem items idx + 2 pos
            CS\coldepth: CS\coldepth - 1
            if null? p -> return null
            CS\log: append CS\log @[@["cclose" "" 0 0]]
            return p
        ]
        if k = 13 [
            unless CS\isblk -> panic "carpintero: into needs block input"
            if pos >= CS\len -> return failAt pos DTEXT "a nested block"
            el: CS\inp\[pos]
            unless block? el -> return failAt pos DTEXT "a nested block"
            ; descend: swap the input for the nested block, match the
            ; operand against all of it, then restore. The descent
            ; index joins the failure path, so nested failures report
            ; a path of indices into the nested structure.
            oInp: CS\inp
            oLen: CS\len
            CS\inp: el
            CS\len: size el
            CS\path: append CS\path pos
            inner: matchElem items idx + 1 0
            done: false
            if null? inner -> done: true
            unless done [
                unless inner = size el [
                    discard failAt inner DTEXT "end of nested block"
                    done: true
                ]
            ]
            CS\path: chop CS\path
            CS\inp: oInp
            CS\len: oLen
            if done -> return null
            return pos + 1
        ]
        if k = 14 [
            lo: items\[idx + 1]
            hi: items\[idx + 2]
            unless and? (integer? lo) (integer? hi) [
                panic "carpintero: between expects two integer bounds"
            ]
            return matchBetween items idx + 3 pos lo hi
        ]
        if k = 15 [
            op: items\[idx + 1]
            unless block? op -> panic "carpintero: do expects a block of host code"
            ; padded with a trailing value before evaluation: binding a
            ; value-less expression corrupts the enclosing frame, and
            ; discard's argument slot is a binding — see bugs,
            ; valueless-assignment.
            ; With the padding, escape blocks may assign, mutate via
            ; set, or call zero-arity functions freely.
            discard do op ++ [true]
            return pos
        ]
        ; defer: a host escape queued in the capture log during
        ; matching and run only on overall success, in match order —
        ; so it rolls back with a dead branch like a capture does,
        ; and runs exactly once per successful scan
        if k = 16 [
            op: items\[idx + 1]
            unless block? op -> panic "carpintero: defer expects a block of host code"
            CS\log: append CS\log @[@["defer" op 0 0]]
            return pos
        ]
        ; cut: commit the innermost enclosing choice block — once
        ; matching passes cut, a later failure in this alternative
        ; stops the whole choice instead of trying the next arm
        if k = 17 [
            if CS\ncuts > 0 [ CS\cuts\[CS\ncuts - 1]: true ]
            return pos
        ]
        if k = 18 [
            unless CS\isblk -> panic "carpintero: quote needs block input"
            if pos >= CS\len -> return null
            v: items\[idx + 1]
            return ((CS\inp\[pos]) = v)? -> pos + 1 -> null
        ]
        ; k = 19, fail
        panic ~"carpintero: |items\[idx + 1]| at position |pos|"
    ]

    ; N R: the count is a retry-free loop, so a failed iteration just
    ; propagates and is rolled back by whoever catches it
    if integer? it [
        p: pos
        if it > 0 [
            loop 1..it 'k [
                p2: matchOne items idx + 1 p
                if p2 = NOTSIMPLE -> p2: matchElem items idx + 1 p
                if null? p2 -> return null
                p: p2
            ]
        ]
        return p
    ]

    matchValue it pos
]

;; a named rule reached through the memo path, which needs a name it
;; can key a table with. The inline dispatch in matchElem is the same
;; thing without the string.
matchNamed: function [w pos][
    unless key? CS\reg w -> panic ~"carpintero: unbound rule word '|w|'"
    v: CS\reg\[w]
    if block? v [
        if CS\nrules < size CS\rules [ CS\rules\[CS\nrules]: w ]
        unless CS\nrules < size CS\rules [ CS\rules: append CS\rules w ]
        CS\nrules: CS\nrules + 1
        p: matchBlock v pos
        CS\nrules: CS\nrules - 1
        return p
    ]
    old: CS\dscw
    CS\dscw: w
    p: matchValue v pos
    CS\dscw: old
    p
]

;; memoized invocation: an entry stores the end position and the
;; capture log slice the rule produced, replayed on a hit — storing
;; only the position would silently drop captures, the Kuramitsu fix
;; from the proposal. Failures memoize too, as a null end position.
;; Two documented losses on a hit: a do escape inside the rule does
;; not re-run, and the farthest-failure report is not re-recorded.
matchNamedMemo: function [w pos][
    pk: (empty? CS\path)? -> (to :string pos) -> (join.with: "," CS\path ++ @[pos])
    mkey: ~"|w|@|pk|"
    if key? MC\tab mkey [
        hit: MC\tab\[mkey]
        if null? hit\0 -> return null
        unless empty? hit\1 [
            loop hit\1 'e [ CS\log: append CS\log @[e] ]
        ]
        return hit\0
    ]
    mark: size CS\log
    p: matchNamed w pos
    stored: []
    unless null? p [
        if (size CS\log) > mark [
            stored: slice CS\log mark (size CS\log) - 1
        ]
    ]
    MC\tab\[mkey]: @[p stored]
    p
]

;; some / any: greedy repetition with the mandatory progress guard —
;; an iteration that matches without consuming ends the loop
matchMany: function.inline [qItems qIdx qPos qNeed][
    qSz: size CS\log
    qP: matchOne qItems qIdx qPos
    if qP = NOTSIMPLE -> qP: matchElem qItems qIdx qPos
    if null? qP [
        if (size CS\log) > qSz [
            CS\log: (qSz = 0)? -> [] -> slice CS\log 0 qSz - 1
        ]
        return (qNeed)? -> null -> qPos
    ]
    qGo: true
    while [qGo][
        qSz: size CS\log
        qP2: matchOne qItems qIdx qP
        if qP2 = NOTSIMPLE -> qP2: matchElem qItems qIdx qP
        qGo: false
        if null? qP2 [
            if (size CS\log) > qSz [
                CS\log: (qSz = 0)? -> [] -> slice CS\log 0 qSz - 1
            ]
        ]
        unless null? qP2 [
            unless qP2 = qP [
                qP: qP2
                qGo: true
            ]
        ]
    ]
    qP
]

matchBetween: function.inline [wItems wIdx wPos wLo wHi][
    wCnt: 0
    wP: wPos
    wGo: true
    while [and? wGo (wCnt < wHi)][
        wSz: size CS\log
        wP2: matchOne wItems wIdx wP
        if wP2 = NOTSIMPLE -> wP2: matchElem wItems wIdx wP
        wGo: false
        if null? wP2 [
            if (size CS\log) > wSz [
                CS\log: (wSz = 0)? -> [] -> slice CS\log 0 wSz - 1
            ]
        ]
        unless null? wP2 [
            unless wP2 = wP [
                wP: wP2
                wCnt: wCnt + 1
                wGo: true
            ]
        ]
    ]
    (wCnt >= wLo)? -> wP -> null
]

;; to / thru: advance until the operand matches
matchScan: function.inline [sItems sIdx sPos sIncl][
    sI: sPos
    while [sI =< CS\len][
        sSz: size CS\log
        sP: matchOne sItems sIdx sI
        if sP = NOTSIMPLE -> sP: matchElem sItems sIdx sI
        unless null? sP -> return (sIncl)? -> sP -> sI
        if (size CS\log) > sSz [
            CS\log: (sSz = 0)? -> [] -> slice CS\log 0 sSz - 1
        ]
        sI: sI + 1
    ]
    null
]

;; a block: ordered alternatives split on the bar symbol, each
;; alternative a sequence. Splitting and matching are the same walk —
;; separating them would visit every item twice, once to find the bars
;; and once to match between them. A bar can only fall on an element
;; boundary, so stepping by element width finds every one of them.
;; Nearly every element is one item wide — a literal, a charset, a
;; rule name — so the width is settled inline and elemSpan is called
;; only for the keywords that take operands.
matchBlock: function.inline [bBlk bPos][
    bN: size bBlk
    if CS\ncuts < size CS\cuts [ CS\cuts\[CS\ncuts]: false ]
    unless CS\ncuts < size CS\cuts [ CS\cuts: append CS\cuts false ]
    CS\ncuts: CS\ncuts + 1
    bIdx: 0
    bP: bPos
    bSz: size CS\log
    bAlive: true
    while [bIdx =< bN][
        bBound: bIdx = bN
        unless bBound [
            bIt: bBlk\[bIdx]
            if symbol? bIt [ bBound: bIt = BAR ]
        ]
        if bBound [
            if bAlive [
                CS\ncuts: CS\ncuts - 1
                return bP
            ]
            ; the alternative that just died was cut, so the choice
            ; dies with it instead of trying what follows
            if CS\cuts\[CS\ncuts - 1] [
                CS\ncuts: CS\ncuts - 1
                return null
            ]
            bAlive: true
            bP: bPos
            bSz: size CS\log
            bIdx: bIdx + 1
        ]
        unless bBound [
            if bAlive [
                bP2: matchOne bBlk bIdx bP
                if bP2 = NOTSIMPLE -> bP2: matchElem bBlk bIdx bP
                if null? bP2 [
                    bAlive: false
                    if (size CS\log) > bSz [
                        CS\log: (bSz = 0)? -> [] -> slice CS\log 0 bSz - 1
                    ]
                ]
                unless null? bP2 [ bP: bP2 ]
            ]
            ; a dead alternative is still walked, to find where it ends
            bIt: bBlk\[bIdx]
            bStep: 1
            if integer? bIt -> bStep: elemSpan bBlk bIdx
            if word? bIt [
                if key? KWCODE bIt -> bStep: elemSpan bBlk bIdx
            ]
            bIdx: bIdx + bStep
        ]
    ]
    CS\ncuts: CS\ncuts - 1
    null
]

;; ── grammar pre-pass ─────────────────────────────────────────────────
;; Runs once per scan, before matching: resolve every named rule — an
;; unbound word is an error here, not a match failure — then compute
;; nullability by fixpoint, and reject left recursion — direct or
;; indirect, including through nullable prefixes. See Left recursion
;; in the proposal. The table it builds is also what the matcher reads
;; rule names out of, so resolution happens once per scan rather than
;; once per invocation.

collectRules: function [blk reg][
    if empty? blk -> return true
    n: size blk
    i: 0
    while [i < n][
        it: blk\[i]
        step: 1
        if block? it [ discard collectRules it reg ]
        if word? it [
            w: to :string it
            if in? w ["quote" "do" "fail" "defer"] -> step: 2
            unless key? KWCODE w [
                unless key? reg w [
                    unless set? w -> panic ~"carpintero: unbound rule word '|w|'"
                    reg\[w]: var w
                    ; A rule word that resolves to a function is almost
                    ; always a constructor call inlined into a rule, the
                    ; one mistake the shape of the dialect invites: rule
                    ; blocks are never evaluated as code, so the call
                    ; never happens and the bare word is what the matcher
                    ; sees. Caught here, in the pre-pass, it names the
                    ; word; caught later it surfaces from inside the
                    ; function that got called by accident.
                    if function? reg\[w] [
                        panic ~"carpintero: rule word '|w|' resolves to a function, not a rule. Rule blocks are never evaluated as code, so a call cannot be inlined into one: build the value outside the rule, bind it to a name, and use the name in the rule."
                    ]
                    if block? reg\[w] [
                        discard collectRules reg\[w] reg
                    ]
                ]
            ]
        ]
        i: i + step
    ]
    true
]

elemNullable?: function [items idx nmap][
    it: items\[idx]
    if string? it -> return (size it) = 0
    if block? it -> return blockNullable? it nmap
    if integer? it -> return or? (it = 0) (elemNullable? items idx + 1 nmap)
    if word? it [
        w: to :string it
        if in? w ["any" "opt" "to" "end" "ahead" "not" "do" "cut" "defer"] -> return true
        if in? w ["some" "thru" "keep"] -> return elemNullable? items idx + 1 nmap
        if w = "into" -> return false
        if w = "between" -> return or? ((items\[idx + 1]) = 0) (elemNullable? items idx + 3 nmap)
        if in? w ["capture" "collect"] -> return elemNullable? items idx + 2 nmap
        if in? w ["quote" "fail" "skip"] -> return false
        return (key? nmap w)? -> nmap\[w] -> false
    ]
    false
]

seqNullable?: function [items start stop nmap][
    idx: start
    while [idx < stop][
        unless elemNullable? items idx nmap -> return false
        idx: idx + elemSpan items idx
    ]
    true
]

blockNullable?: function [blk nmap][
    nItems: size blk
    start: 0
    i: 0
    result: false
    while [i =< nItems][
        isBar: false
        if i < nItems [
            if symbol? blk\[i] [ isBar: (blk\[i]) = BAR ]
        ]
        if or? isBar (i = nItems) [
            if seqNullable? blk start i nmap -> result: true
            start: i + 1
        ]
        i: i + 1
    ]
    result
]

computeNullmap: function [reg][
    nmap: #[]
    if empty? keys reg -> return nmap
    loop keys reg 'k [
        v: reg\[k]
        nmap\[k]: (string? v)? -> ((size v) = 0) -> false
    ]
    changed: true
    while [changed][
        changed: false
        loop keys reg 'k [
            v: reg\[k]
            if block? v [
                if and? (blockNullable? v nmap) (not? nmap\[k]) [
                    nmap\[k]: true
                    changed: true
                ]
            ]
        ]
    ]
    nmap
]

;; names invocable at the same input position as the element at idx
elemHeads: function [items idx nmap][
    it: items\[idx]
    if block? it -> return blockHeads it nmap
    if integer? it -> return (it = 0)? -> [] -> elemHeads items idx + 1 nmap
    if word? it [
        w: to :string it
        if in? w ["some" "any" "opt" "to" "thru" "ahead" "not" "keep"] -> return elemHeads items idx + 1 nmap
        if w = "between" -> return elemHeads items idx + 3 nmap
        if in? w ["capture" "collect"] -> return elemHeads items idx + 2 nmap
        ; into starts its operand at position 0 of a strictly smaller
        ; input, so descent is progress and cannot left-recurse
        if in? w ["quote" "do" "fail" "skip" "end" "into" "cut" "defer"] -> return []
        return @[w]
    ]
    []
]

seqHeads: function [items start stop nmap][
    hs: []
    idx: start
    while [idx < stop][
        hs: hs ++ elemHeads items idx nmap
        unless elemNullable? items idx nmap -> return hs
        idx: idx + elemSpan items idx
    ]
    hs
]

blockHeads: function [blk nmap][
    hs: []
    nItems: size blk
    start: 0
    i: 0
    while [i =< nItems][
        isBar: false
        if i < nItems [
            if symbol? blk\[i] [ isBar: (blk\[i]) = BAR ]
        ]
        if or? isBar (i = nItems) [
            hs: hs ++ seqHeads blk start i nmap
            start: i + 1
        ]
        i: i + 1
    ]
    hs
]

dfsCycle: function [k reg nmap state path][
    if state\[k] = 2 -> return true
    if state\[k] = 1 [
        cyc: join.with: " -> " append path k
        panic ~"carpintero: left recursion detected: |cyc|"
    ]
    state\[k]: 1
    v: reg\[k]
    if block? v [
        hs: blockHeads v nmap
        unless empty? hs [
            loop hs 'h [
                if key? reg h [
                    discard dfsCycle h reg nmap state append path k
                ]
            ]
        ]
    ]
    state\[k]: 2
    true
]

;; verified rule sets, keyed by the rule and every resolved rule body,
;; so redefining a named rule re-triggers the check — the cached per
;; rule set behavior from the proposal
GCACHE: #[]

checkGrammar: function [rule][
    reg: #[]
    discard collectRules rule reg
    if empty? keys reg -> return reg
    h: to :string hash @[rule reg]
    if key? GCACHE h -> return reg
    nmap: computeNullmap reg
    state: #[]
    loop keys reg 'k [ state\[k]: 0 ]
    loop keys reg 'k [ discard dfsCycle k reg nmap state [] ]
    GCACHE\[h]: true
    reg
]

;; ── public API ───────────────────────────────────────────────────────
;; scan      : dictionary of captures, or null on failure
;; scan?     : boolean
;; scanError : message for the most recent failed scan, with line and
;;             column for string input and index for block input
;; The whole input must match; scan.prefix accepts a prefix match and
;; reports how far it reached.

scan: function [input rule][
    pfx: attr 'prefix
    mset: attr 'memo
    MC\rules: []
    MC\on: false
    unless null? mset [
        unless empty? mset [
            loop mset 'x [ MC\rules: append MC\rules to :string x ]
            MC\on: true
        ]
    ]
    MC\tab: #[]
    CS\reg: checkGrammar rule
    ; S1: string input becomes a block of characters, once
    if block? input [
        CS\isblk: true
        CS\inp: input
    ]
    unless block? input [
        CS\isblk: false
        CS\inp: map input 'c -> c
    ]
    CS\len: size CS\inp
    CS\log: []
    CS\farpath: []
    CS\exp: []
    CS\coldepth: 0
    CS\nrules: 0
    CS\dscw: ""
    CS\ctx: ""
    CS\quiet: 0
    CS\path: []
    CS\ncuts: 0
    p: matchBlock rule 0
    if null? p -> return null
    if and? (null? pfx) (p <> CS\len) -> return null
    caps: #[]
    cnames: []
    citems: []
    unless empty? CS\log [
        loop CS\log 'e [
            kind: e\0
            ; cap and keep entries carry the input they refer to, since
            ; a capture inside into spans the nested block, not the top
            if kind = "cap" [
                caps\[e\1]: capValue e\4 e\2 e\3
            ]
            if kind = "copen" [
                cnames: append cnames e\1
                citems: append citems @[[]]
            ]
            if kind = "keep" [
                top: (size citems) - 1
                citems\[top]: append citems\[top] @[capValue e\4 e\2 e\3]
            ]
            if kind = "cclose" [
                top: (size citems) - 1
                caps\[last cnames]: citems\[top]
                cnames: chop cnames
                citems: chop citems
            ]
            ; deferred escapes run here, on commit, in match order,
            ; padded like the do escape
            if kind = "defer" [
                discard do e\1 ++ [true]
            ]
        ]
    ]
    (null? pfx)? -> caps -> #[reached: p  captures: caps]
]

;; materialize one logged span. Block input yields a block; string
;; input yields the characters joined back into a string, since that
;; is the representation the caller handed in — see S1.
capValue: function.inline [cvSrc cvFrom cvTo][
    if cvFrom = cvTo -> return (CS\isblk)? -> [] -> ""
    cvSl: slice cvSrc cvFrom cvTo - 1
    (CS\isblk)? -> cvSl -> join cvSl
]

;; human-readable report for the most recent failed scan, built from
;; the farthest-failure high-water mark
scanError: function [][
    f: (empty? CS\farpath)? -> 0 -> last CS\farpath
    exp: (empty? CS\exp)? -> "end of input" -> join.with: ", " CS\exp
    ctxs: (CS\ctx = "")? -> "" -> ~"  (while matching: |CS\ctx|)"
    if CS\isblk [
        if 1 < size CS\farpath [
            pth: join.with: " " CS\farpath
            return ~"scan failed at index path |pth| — expected: |exp||ctxs|"
        ]
        return ~"scan failed at index |f| — expected: |exp||ctxs|"
    ]
    line: 1
    col: 1
    nl: to :char 10
    i: 0
    while [i < f][
        c: CS\inp\[i]
        col: col + 1
        if c = nl [
            line: line + 1
            col: 1
        ]
        i: i + 1
    ]
    ; the offending source line, with a caret under the column
    ls: f
    while [and? [ls > 0] [(CS\inp\[ls - 1]) <> nl]][ ls: ls - 1 ]
    le: f
    while [and? [le < CS\len] [(CS\inp\[le]) <> nl]][ le: le + 1 ]
    excerpt: (ls = le)? -> "" -> join slice CS\inp ls le - 1
    pad: (col > 1)? -> repeat " " col - 1 -> ""
    join.with: to :string nl @[
        ~"scan failed at line |line|, column |col| — expected: |exp||ctxs|"
        ~"    |excerpt|"
        ~"    |pad|^"
    ]
]

scan?: function [input rule][
    not? null? scan input rule
]

;; ── comment-safe source loading ──────────────────────────────────────
;; The 0.10.0 lexer does not fully ignore comment contents: a
;; backslash-dash in a comment hangs the file loader, and quotes or
;; brackets in comments corrupt the token stream — see bugs. The way
;; around it, from first principles: read gives us the raw source as a
;; string without lexing anything, so strip comments at the string
;; level and only then hand the result to the lexer, which never sees
;; a comment byte. The stripper is a Carpintero grammar — this package
;; fixing the language lexer with its own dialect. Newlines are kept,
;; so line numbers survive stripping.

;;
;; Every loop here runs once per character of the input, so this is the
;; one grammar in the package where the cost of a terminal is worth
;; caring about. The rule is: a run of ordinary characters must cost one
;; charset test per character, not a stack of lookaheads.
;;
;; The earlier srcPlain read
;;     some [not quote not brace not apostrophe not semicolon skip]
;; which is four negative lookaheads and a skip — five rule invocations
;; for every ordinary character, and ordinary characters are almost all
;; of any source file. Each of those sets is now the complement of the
;; characters that end the run, which the matcher settles with a single
;; lookup in the charset ASCII table. Same language, an order of
;; magnitude less work; the corpus run in examples proves the two agree
;; over a megabyte of Arturo's own source.

SRCNL: to :char 10
SRCBS: to :char 92

;; the four characters that can begin something srcPlain must not eat:
;; a double quote, an open curly, an apostrophe, a semicolon
srcOpeners:  charset join @[(to :char 34) (to :char 123) (to :char 39) (to :char 59)]
srcOrdinary: csComplement srcOpeners

;; inside a double-quoted string, anything but a quote or a backslash;
;; the backslash is handled by srcEsc, which takes the character after
;; it whatever that is
srcInStr: csComplement charset join @[(to :char 34) SRCBS]

;; inside a curly string, anything but a brace either way: an open one
;; starts a nested string and a close one ends this one
srcInCurly: csComplement charset join @[(to :char 123) (to :char 125)]

;; a comment runs to the end of the line
srcInComment: csComplement charset to :string SRCNL

;; the ordinary character leads inside these loops too, for the same
;; reason it leads at the top: an escape and a nested curly are the rare
;; cases, and the sets are disjoint, so the order is free to follow the
;; frequencies.
srcEsc:     [SRCBS skip]
srcStr:     [{"} any [srcInStr | srcEsc] {"}]
srcCurly:   ["{" any [srcInCurly | srcCurly] "}"]
srcChar:    ["'" not "'" skip "'"]
srcComment: [";" any srcInComment]
srcPlain:   [some srcOrdinary]

;; srcPlain leads: it is the arm that matches at most positions, and it
;; cannot match at any character the other arms want, so putting it
;; first costs the specials one failed test and saves every run of
;; ordinary text four.
srcClean:   [collect 'parts [
    any [keep srcPlain | keep srcStr | keep srcCurly | keep srcChar
        | srcComment | keep skip]
]]

;; source string in, source string without comments out
stripComments: function [src][
    r: scan src srcClean
    join r\parts
]

;; path in, lexed block out; evaluate it with do at top level, where
;; definitions bind globally. Files whose comments would hang or
;; confuse the interpreter load correctly through here. The block is
;; padded with a trailing true so the do always produces a value, since
;; binding a value-less one corrupts the frame — the do result is the
;; padding, not the file's last value.
loadSafe: function [path][
    to :block (stripComments read path) ++ " true"
]
