; A value left unused inside a function body is popped as an argument by the
; call that encloses it, and the argument already supplied in that slot is
; pushed down out of reach. Every line below would print `expected: 42` if
; the leftover stayed out of the enclosing argument list.

earlyReturn: function [x][
    if x -> return 7
    8
]
plain: function [][ 9 ]

viaReturn:   function [a b][ earlyReturn true  true ]
viaFallthru: function [a b][ earlyReturn false true ]
viaCall:     function [a b][ plain            true ]
viaLiteral:  function [a b][ 99               true ]

show: function [label got expected][
    print [label "| got:" got "| expected:" expected]
]

show "return  " viaReturn   1 2 42      ; expected: 7
show "fallthru" viaFallthru 1 2 42      ; expected: 8
show "call    " viaCall     1 2 42      ; expected: 9
show "literal " viaLiteral  1 2 42      ; expected: 99

; `return` is not the trigger: a bare literal does the same. Nothing is lost
; either. Each displaced 42 stays on the stack and reaches the next call that
; wants an argument, which is the whole of the feature: all four are still
; there below, and the first one out lands in `takesOne`.

7
print                                   ; prints 7

takesOne: function [v][ print ["and the 42 turns up here:" v] ]
print ["stack after the calls above:" stack]
takesOne
