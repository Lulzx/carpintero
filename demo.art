;; demo.art — exercises the Phase 0 draft in carpintero.art

import ./"carpintero.art"!

check: function [label got expected][
    status: (got = expected)? -> "ok  " -> "FAIL"
    print [status label "->" got]
]

;; the proposal's opening example
digit: charset "0-9"

date: [
    capture 'year  [4 digit]  "-"
    capture 'month [2 digit]  "-"
    capture 'day   [2 digit]
]

r: scan "2026-08-03" date
check "date: year"  r\year  "2026"
check "date: month" r\month "08"
check "date: day"   r\day   "03"
check "date: bad input is null" scan "2026-8-03" date null
check "scan? yes" scan? "2026-08-03" date true
check "scan? no"  scan? "2026-08-3x" date false

;; whole-input contract and prefix mode
check "partial match fails" scan? "2026-08-03 extra" date false
pr: scan.prefix "2026-08-03 extra" date
check "prefix: reached" pr\reached 10
check "prefix: captures" pr\captures\year "2026"

;; alternation, ordered choice
ab: [some ["a" | "b"]]
check "alternation" scan? "abba" ab true
check "alternation rejects" scan? "abca" ab false

;; capture rollback: the failed alternative's capture must not leak
leak: [capture 'x "ab" "!" | capture 'y "abc"]
r2: scan "abc" leak
check "rollback: dead capture gone" key? r2 "x" false
check "rollback: live capture kept" r2\y "abc"

;; recursion: balanced parens
parens: ["(" any parens ")"]
check "recursion: balanced" scan? "(()(()))" [some parens] true
check "recursion: unbalanced" scan? "(()" [some parens] false

;; quantifiers
check "exact count" scan? "aaaa" [4 "a"] true
check "exact count fails" scan? "aaa" [4 "a"] false
check "between" scan? "aaa" [between 2 4 "a"] true
check "between too few" scan? "a" [between 2 4 "a"] false
check "opt present" scan? "-5" [opt "-" some digit] true
check "opt absent" scan? "5" [opt "-" some digit] true

;; progress guard: a nullable loop body terminates instead of hanging
check "progress guard" scan? "xy" [some [opt "a"] "xy"] true

;; to / thru
kv: [capture 'k to "=" thru "=" capture 'v [some skip]]
r3: scan "key=value" kv
check "to: key" r3\k "key"
check "thru: value" r3\v "value"

;; charset ranges and literal dash
ident: charset "a-z0-9-"
check "charset range" scan? "abc-42" [some ident] true
check "charset rejects" scan? "ABC" [some ident] false

;; charsets are values and compose
hexdigit: csUnion digit charset "a-f"
check "csUnion" scan? "9f" [2 hexdigit] true
consonant: csIntersect charset "a-z" csComplement charset "aeiou"
check "csIntersect of csComplement" scan? "bcd" [some consonant] true
check "complement excludes" scan? "e" [consonant] false

;; last-wins on repeated capture
r4: scan "aaab" [some [capture 'c skip]]
check "last capture wins" r4\c "b"

;; unbound rule word is a grammar error (uncomment to see the panic)
; scan "x" [nosuchrule]

;; left recursion is rejected with the cycle named (uncomment to see)
; expr: [expr "+" digit | digit]
; scan "1+2" expr

;; a JSON validator: mutual recursion stress test
;; whitespace kept to spaces only for brevity
ws: [any " "]
jstring: [{"} to {"} skip]
jnumber: [opt "-" some digit opt ["." some digit]]
jvalue: [jstring | jnumber | jobject | jarray | "true" | "false" | "null"]
jarray: ["[" ws opt [jvalue ws any ["," ws jvalue ws]] "]"]
jpair: [jstring ws ":" ws jvalue]
jobject: ["{" ws opt [jpair ws any ["," ws jpair ws]] "}"]

check "json accepts" scan? {{"a": [1, 2.5, "x"], "b": {"c": null}}} jvalue true
check "json empty containers" scan? {{"a": [], "b": {}}} jvalue true
check "json rejects" scan? {{"a": }} jvalue false

;; Phase 1, block matching. The flagship of the proposal, pattern-matching Arturo code itself.

check "block: type terminals" scan? [42 "hi"] [:integer :string] true
check "block: type mismatch" scan? [42 42] [:integer :string] false
check "block: literal word" scan? [function] ['function] true
check "block: quote escapes keywords" scan? [some 5] [quote some quote 5] true
check "block: string element" scan? ["ab" "cd"] ["ab" skip] true

code: [
    greet: function [name][ print name ]
    x: 10
    add: function [a b][ a + b ]
]

funcdef: [
    capture 'name :label
    'function
    capture 'params :block
    capture 'body :block
]

r5: scan code [any [funcdef | skip]]
check "block: funcdef found (last wins)" to :string first r5\name "add"
check "block: funcdef params" first r5\params [a b]
check "block: non-code rejects" scan? [1 2 3] funcdef false

;; into: descend into a nested block with its own rules
pair: [:integer :string]
check "into descends" scan? [[1 "a"] [2 "b"]] [some [into pair]] true
check "into needs whole nested match" scan? [[1 "a" "x"]] [into pair] false
check "into rejects non-block element" scan? [42] [into pair] false
r5b: scan [[1 "one"] [2 "two"]] [some [into [:integer capture 'w :string]]]
check "into: nested capture (last wins)" first r5b\w "two"

;; a failure inside a nested block reports a path of indices into it
r5c: scan [[1 "a"] [2 3]] [some [into [:integer :string]]]
check "into: error is a path" in? "index path 1 1" scanError true

;; Phase 2, lookahead, collect and keep, host escape, error reporting.

check "ahead looks without consuming" scan? "ab" [ahead "ab" "ab"] true
check "not negates" scan? "ba" [not "a" skip skip] true
check "not fails on match" scan? "ab" [not "a" skip skip] false

;; a lookahead consumes nothing, so it keeps nothing: a capture survives
;; only if the match consumed the input it names
r5b: scan "ab" [ahead [capture 'peek "a"] "ab"]
check "ahead captures nothing" key? r5b "peek" false

alpha: charset "a-z"
r6: scan "one, two, three" [collect 'words [some [keep [some alpha] | skip]]]
check "collect gathers" size r6\words 3
check "collect first" first r6\words "one"

;; keeps from a failed alternative must disappear with it
r7: scan "abc" [collect 'xs [keep "ab" "!"] | thru end]
check "collect rollback" key? r7 "xs" false

;; the re-run contract for host escapes, demonstrated: the escape runs
;; once per loop attempt, including the attempt that fails
G: #[n: 0]
note: function [x][ G\n: G\n + x  x ]
r8: scan "aab" [some [do [note 1] "a"] "b"]
check "do runs per attempt" G\n 3

;; escape blocks may assign directly: the matcher pads them with a
;; trailing value before evaluation, which sidesteps the interpreter
;; crash a value-less escape block used to cause
G4: #[n: 0]
r8b: scan "ab" ["a" do [G4\n: 5] "b"]
check "do escape may assign" G4\n 5
r8c: scan "ab" ["a" defer [G4\n: G4\n + 2] "b"]
check "defer escape may assign" G4\n 7

;; Phase 3, cut, deferred escapes, opt-in memoization.

;; cut commits the innermost enclosing choice: after cut, a failure
;; stops the whole choice instead of trying the next alternative
check "cut commits a choice" scan? "ab" ["a" cut "x" | "ab"] false
check "no cut, next arm tried" scan? "ab" ["a" "x" | "ab"] true
check "cut is local to its block" scan? "ab" [["a" cut "x" | "z"] | "ab"] true

;; defer: a host escape that runs only on overall success, exactly
;; once, in match order — dead branches take their defers with them.
;; escape functions end with a value on purpose: a function whose
;; body ends in an assignment crashes when invoked through do
G2: #[n: 0]
bump: function [x][ G2\n: G2\n + x  x ]
r10: scan "ab" ["a" defer [bump 1] "b"]
check "defer runs on commit" G2\n 1
r11: scan "ax" ["a" defer [bump 10] "b"]
check "defer skipped on failure" G2\n 1
r12: scan "abab" [["ab" defer [bump 100] "x"] | "abab"]
check "defer dies with its branch" G2\n 1

;; opt-in memoization: scan.memo names the rules to memoize. A hit
;; replays the capture log slice, so captures survive, and skips
;; re-evaluation, so the do escape inside runs once, not twice.
G3: #[n: 0]
mrule: [do [bump3 1] capture 'm "ab"]
bump3: function [x][ G3\n: G3\n + x  x ]
r13: scan.memo: ['mrule] "abab" [mrule "x" | mrule "ab"]
check "memo replays captures" r13\m "ab"
check "memo hit skips re-evaluation" G3\n 1
r14: scan "abab" [mrule "x" | mrule "ab"]
check "without memo it runs twice" G3\n 3

;; farthest-failure error report: the Phase 2 target message — the
;; failing terminal reported by its rule name, the enclosing capture
;; as context, and the source line with a caret under the column
r9: scan "2026-08-0x" date
msg: scanError
check "error line and column" in? "line 1, column 10" msg true
check "error names the rule" in? "expected: digit" msg true
check "error gives context" in? "while matching: day" msg true
check "error draws a caret" in? "         ^" msg true
print ""
print "the report itself:"
print msg
print ""

;; comment-safe loading: the stripper keeps the lexer from ever seeing
;; a comment byte. The hostile comment is built programmatically so
;; this file itself stays safe to lex.
nlc: to :string to :char 10
bsc: to :string to :char 92
hostile: join @[";" " bad " bsc "- comment" nlc "hx: 42" nlc "hx"]
cleaned: stripComments hostile
check "stripComments removes the bomb" in? bsc cleaned false
r15: do to :block cleaned
check "stripped source runs" r15 42
guarded: join @["hy: " {"} "semi ; inside" {"} nlc "hy"]
r16: do to :block stripComments guarded
check "semicolon in string survives" r16 "semi ; inside"

print ""
print "-- error demos (each panics; run separately) -----------------"
print {   scan "x" [nosuchrule]}
print {   expr: [expr "+" digit | digit]  ;  scan "1+2" expr}
